# Host-mode / local development settings for the API (`pnpm dev:api`,
# `pnpm --filter @cloudops/api db:migrate`, seed, tests' CLI tools).
#
#   cp apps/api/.env.example apps/api/.env
#
# Loaded automatically when present; anything already set in your shell wins.
# Never used by Docker (the containers get their settings from the repo-root
# .env through docker-compose). Full reference: docs/configuration.md

DATABASE_URL=postgresql://cloudops:cloudops@localhost:5432/cloudops?schema=public
REDIS_URL=redis://localhost:6379

# Any two different values work locally; production needs strong ones.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Host mode reuses your own `az login`. Leave AZURE_CONFIG_DIR unset to use the
# Azure CLI's default profile (~/.azure). Set to false to forbid tag writes.
AZURE_ALLOW_WRITE=true
