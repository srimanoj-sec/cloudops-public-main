# ─────────────────────────────────────────────────────────────
# CloudOps Platform — environment configuration
# Copy to `.env` (defaults below work out of the box for local Docker).
# ─────────────────────────────────────────────────────────────

# Full reference: docs/configuration.md

# --- General ---
# `production` makes the API refuse to boot with default/weak JWT secrets.
NODE_ENV=development

# --- API ---
API_PORT=3000
# Comma-separated list of allowed web origins for CORS
CORS_ORIGIN=http://localhost:5173
# error | warn | info | debug  (default: info in production, debug otherwise)
# LOG_LEVEL=info
# Behind a reverse proxy? Set to the hop count (e.g. 1) so rate limits and the
# audit log see real client IPs. Leave off when clients connect directly.
TRUST_PROXY=false
# Redis-backed abuse protection on sign-in and expensive endpoints.
RATE_LIMIT_ENABLED=true
# Prometheus: set a random value (16+ chars) to enable GET /metrics; scrapers
# send it as `Authorization: Bearer <token>`. Unset = no metrics endpoint.
# METRICS_TOKEN=

# --- Auth (local JWT) ---
# CHANGE THESE in any non-local deployment: two DIFFERENT random values of 32+
# characters, e.g. `openssl rand -base64 48`. Required when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# First admin — created on first boot only if this email doesn't exist yet.
# Change the password after the first login (user menu → Change password).
SEED_ADMIN_EMAIL=admin@cloudops.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- PostgreSQL (authoritative offline-first cache) ---
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops
POSTGRES_DB=cloudops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Prisma connection string (host=postgres inside Docker network)
DATABASE_URL=postgresql://cloudops:cloudops@postgres:5432/cloudops?schema=public

# --- Redis (BullMQ queues + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Credential provider ---
# Order of secret resolution (never stored in Postgres):
# azure-cli -> windows-credential-manager -> key-vault -> env
CREDENTIAL_PROVIDER=azure-cli

# --- Local credential store (UI-entered cloud credentials) ---
# Organizations added on the Providers page are written here as an AES-256-GCM
# envelope: <CLOUDOPS_DATA_DIR>/credentials/provider-accounts.enc.json.
# Default data dir: <your home>/.cloudops  (in Docker, a mounted volume).
# CLOUDOPS_DATA_DIR=/data
# Optional 32-byte key (hex or base64). Leave unset and a key file is generated
# next to the store on first write. Supply one to keep the key off this machine.
# CREDENTIAL_STORE_KEY=

# --- Azure authentication ---
# Two supported modes (see docs/deployment.md):
#
# 1) HOST MODE (recommended on Windows to reuse an interactive `az login`):
#    run the API on the host — `pnpm dev:api` — with Postgres/Redis/web in Docker.
#    No secrets needed; the API reuses your existing `az login` session.
#
# 2) SERVICE PRINCIPALS (fully containerized sync, and the multi-org setup):
#    one service principal per Azure org (Entra tenant). The API runs
#    `az login --service-principal` per org and syncs every subscription across
#    all orgs. Extensible to any number of orgs. Secrets are NEVER stored in
#    Postgres.
#
#    Preferred: add each org in the UI (Providers → Add organization). Nothing
#    goes in this file, and changes apply without restarting the API.
#
#    Alternative: declare them here with AZURE_ORGS (below). Orgs declared this
#    way are read-only in the UI; an org configured in BOTH places uses the copy
#    entered in the UI.
# AZURE_ORGS=[{"name":"Org 1","tenantId":"<t1>","clientId":"<appId1>","clientSecret":"<pw1>"},{"name":"Org 2","tenantId":"<t2>","clientId":"<appId2>","clientSecret":"<pw2>"}]
#
# Single-SP fallback (one org):
# AZURE_ORG_NAME=Default
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Azure CLI profile used in host mode. Service-principal orgs always get their
# own isolated profile under <CLOUDOPS_DATA_DIR>/az-profiles/.
AZURE_CONFIG_DIR=/root/.azure
# Tag name the sync reads each resource's owner from (case-insensitive). Default: Owner
AZURE_OWNER_TAG=Owner
# Master switch for write-back to Azure: tag writes and approved remediations
# (property changes, VM power, deleting unused IPs/NICs/plans). Default: on.
# Tags need "Tag Contributor"; remediations need Contributor on the target scope.
# Set to false to make the platform strictly read-only (plans still work).
AZURE_ALLOW_WRITE=true
# Remediation four-eyes: medium/high-risk changes need a second person to
# approve. Set true only for a single-admin install where nobody else can.
REMEDIATION_SELF_APPROVAL=false

# --- FinOps / cost ---
# Days of daily cost pulled per cost sync (Cost Management via `az rest`).
# Wide enough for custom ranges + period comparison. Per-resource "monthly"
# cost is always the trailing 30 days regardless.
FINOPS_WINDOW_DAYS=90
# Set to true to auto-run a daily cost sync in the background (off by default).
FINOPS_DAILY_SYNC=false
# Reporting currency. Every amount is stored and shown in it; subscriptions that
# Azure bills in another currency (e.g. a USD sponsorship) are converted during
# the cost sync at Microsoft's rate from the Azure retail price list.
COST_CURRENCY=INR
# Optional: pin rates instead (1 unit of that currency in COST_CURRENCY).
# COST_FX_RATES=USD=95.5

# --- Web ---
# The API URL the browser calls. Baked into the bundle at BUILD time — rebuild
# the web image (`docker compose up -d --build web`) after changing it.
VITE_API_BASE_URL=http://localhost:3000
# Origin of that URL; the web Content-Security-Policy allows calls only there.
API_ORIGIN=http://localhost:3000
