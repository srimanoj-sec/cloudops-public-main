{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@cloudops/kernel": ["packages/kernel/src/index.ts"],
      "@cloudops/core": ["packages/core/src/index.ts"],
      "@cloudops/credentials": ["packages/credentials/src/index.ts"],
      "@cloudops/provider-sdk": ["packages/provider-sdk/src/index.ts"],
      "@cloudops/provider-azure": ["packages/provider-azure/src/index.ts"]
    }
  }
}
