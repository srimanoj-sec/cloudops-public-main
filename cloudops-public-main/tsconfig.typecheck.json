{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/prisma/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/dist/**", "**/node_modules/**"]
}
